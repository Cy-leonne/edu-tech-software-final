# ============================================================================
# School Management System – backend environment template
#
# Copy this file to `.env` and fill in real values. NEVER commit the real .env.
#   cp .env.example .env
# ============================================================================

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
# Comma separated list of allowed browser origins (the frontend URL(s)).
# Used for CORS and for building password-reset links (first entry wins).
FRONTEND_URL=http://localhost:3000
# Number of trusted reverse-proxy hops in front of the API (used for correct
# client IPs in rate limiting / audit logs). Set 1 behind nginx, 0 if direct.
TRUST_PROXY_HOPS=1

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
MONGO_URL=mongodb://127.0.0.1:27017/schoolManagementSystem
# MONGO_URI is also accepted as an alias of MONGO_URL
# MONGO_URI=mongodb://user:password@host:27017/schoolManagementSystem

# ---------------------------------------------------------------------------
# Authentication / sessions
# ---------------------------------------------------------------------------
# REQUIRED: secret used to sign admin JWT access tokens.
JWT_SECRET=replace-with-a-long-random-secret
# Optional alias still read by the code base
# SECRET_KEY=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
# Data-at-rest key for encrypted personal fields (students/employees)
ENCRYPTION_KEY=replace-with-a-long-random-secret

# ---------------------------------------------------------------------------
# Password reset
# ---------------------------------------------------------------------------
# Lifetime of a password-reset link, in minutes (default 60, max 1440).
PASSWORD_RESET_TTL_MINUTES=60

# ---------------------------------------------------------------------------
# Email delivery (password reset + notifications)
# ---------------------------------------------------------------------------
# auto | sendgrid | smtp | demo
#  - auto     : SendGrid when SENDGRID_API_KEY is set, else SMTP, else demo log
#  - sendgrid : SendGrid Web API v3 (recommended for password reset delivery)
#  - smtp     : nodemailer SMTP relay
#  - demo     : no delivery – messages are logged with tokens masked
EMAIL_PROVIDER=sendgrid

# --- SendGrid (EMAIL only – SendGrid does not provide SMS) ---
# Create an API key with "Mail Send" permission at
# https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.your-sendgrid-api-key
# A verified sender identity in your SendGrid account
EMAIL_FROM=no-reply@your-domain.com
EMAIL_FROM_NAME=School Management System
# Optional: SendGrid EU regional endpoint
# SENDGRID_API_BASE_URL=https://api.eu.sendgrid.com/v3/mail/send
# Optional: validate the integration without delivering mail (SendGrid test mode)
# SENDGRID_SANDBOX_MODE=false
# Optional reply-to address
# EMAIL_REPLY_TO=support@your-domain.com

# --- SMTP relay (only used when EMAIL_PROVIDER=smtp) ---
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-password

# ---------------------------------------------------------------------------
# SMS (separate provider – SendGrid is email only)
# ---------------------------------------------------------------------------
# twilio | africast | demo
SMS_PROVIDER=demo
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
AFRICAST_API_KEY=
AFRICAST_USERNAME=
AFRICAST_SENDER_ID=SchoolMgmt

# ---------------------------------------------------------------------------
# Payments – M-Pesa STK Push (existing provider, retained)
# ---------------------------------------------------------------------------
MPESA_ENVIRONMENT=sandbox
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_BUSINESS_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-domain.com/Payment/MpesaCallback

# Callback verification (strongly recommended in production):
#  - MPESA_CALLBACK_SECRET: shared secret. Send it as the
#    `x-mpesa-callback-secret` header (or `?secret=`), or send an HMAC-SHA256
#    of the raw JSON body in `x-mpesa-signature`.
#  - MPESA_CALLBACK_IPS: comma separated allow-list of provider egress IPs.
#  - MPESA_CALLBACK_REQUIRE_VERIFICATION=true rejects every callback that
#    cannot be verified (use once at least one option above is configured).
MPESA_CALLBACK_SECRET=
MPESA_CALLBACK_IPS=
MPESA_CALLBACK_REQUIRE_VERIFICATION=false

# ---------------------------------------------------------------------------
# Payments – bank/aggregator webhook (POST /Student/PaymentWebhook)
# ---------------------------------------------------------------------------
# REQUIRED for that endpoint to operate. Requests must present either
#   `x-webhook-secret: <secret>`  or  `x-payment-signature: <hex HMAC-SHA256 of
#   the raw body with this secret>`. Without it the endpoint fails closed.
PAYMENT_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# PayWave
# ---------------------------------------------------------------------------
# NOT CONFIGURED – see PROJECT_ENHANCEMENT_REPORT.md.
# The repository contains no PayWave integration and no PayWave API
# documentation/credentials were supplied, so no PayWave client was generated.
# Required before PayWave can be made the default payment route:
#   PAYWAVE_BASE_URL=, PAYWAVE_API_KEY=, PAYWAVE_MERCHANT_ID=,
#   PAYWAVE_CALLBACK_URL=, PAYWAVE_ENVIRONMENT=  (+ official API docs)

# ---------------------------------------------------------------------------
# Backups / maintenance
# ---------------------------------------------------------------------------
AUTO_BACKUP_ENABLED=true
AUTO_BACKUP_INTERVAL_MS=86400000

# ---------------------------------------------------------------------------
# Test / development only switches (ignored when NODE_ENV=production)
# ---------------------------------------------------------------------------
# Enable the in-memory demo database fallback (backend/testdb.js).
# WARNING: it contains well known demo credentials - never enable in production.
ENABLE_TEST_DB_FALLBACK=false
# Disable the mock STK/payment test helpers
# DISABLE_TEST_PAYMENT_ENDPOINTS=true
# Enable the developer email diagnostic endpoint POST /Test/SendResetEmail
ENABLE_TEST_EMAIL_ENDPOINT=false

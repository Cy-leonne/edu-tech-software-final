
# ============================================================================
# School Management System – frontend environment template
# Copy to `.env` (development) or `.env.production` (production build).
# Only REACT_APP_* variables are exposed to the browser bundle: never put
# secrets here.
# ============================================================================

# Base URL of the backend API.
#  - Leave EMPTY in development: the CRA dev server proxies API calls to the
#    backend on the same origin (see src/setupProxy.js).
#  - Set the public API origin for production, e.g. https://api.your-domain.com
REACT_APP_BASE_URL=

# Hide source maps in production builds
GENERATE_SOURCEMAP=false

# Show the guest/demo login shortcuts on the portal chooser page.
# Keep false in production: the demo accounts rely on demo credentials.
REACT_APP_ENABLE_GUEST_DEMO=false

# ---------------------------------------------------------------------------
# Guest / demo login (optional, disabled by default)
# ---------------------------------------------------------------------------
# To actually use the demo shortcuts you must ALSO enable the backend demo
# dataset (ENABLE_TEST_DB_FALLBACK=true and NODE_ENV != production) and provide
# the demo credentials here. Nothing is hard-coded in the source/bundle.
# REACT_APP_GUEST_ADMIN_EMAIL=
# REACT_APP_GUEST_ADMIN_PASSWORD=
# REACT_APP_GUEST_SUPERADMIN_EMAIL=
# REACT_APP_GUEST_SUPERADMIN_PASSWORD=
# REACT_APP_GUEST_TEACHER_EMAIL=
# REACT_APP_GUEST_TEACHER_PASSWORD=
# REACT_APP_GUEST_STUDENT_ADMISSION_NO=
# REACT_APP_GUEST_STUDENT_NAME=
# REACT_APP_GUEST_STUDENT_PASSWORD=

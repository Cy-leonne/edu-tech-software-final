    requestStudentPasswordReset,
    resetStudentPassword,
    changeStudentPassword,
    resetStudentPasswordByAdmin,
    cleanupTempStudent,
    getAcademicReport,
    searchStudent,
    searchChequePayment,
    importStudents,
    generateUniqueStudentEmail,
    generateAdmissionNumber,
};

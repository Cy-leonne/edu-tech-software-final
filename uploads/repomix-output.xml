        }
    }, [timetable]);

    const subjectOptions = useMemo(() => {
        return Array.isArray(subjectsList) ? subjectsList.map((subject) => ({
            id: subject._id,
            subName: subject.subName,
            teacherId: subject.teacher?._id || null,
            teacherName: subject.teacher?.name || 'Unassigned',

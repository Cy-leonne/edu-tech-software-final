}

const deleteSclasses = async (req, res) => {
    try {
        if (!(await verifySchoolId(req, res, req.params.id))) return;
        const deletedClasses = await Sclass.deleteMany({ school: req.params.id });
        if (deletedClasses.deletedCount === 0) {

POST /SuperAdmin/Admin/Register
x-admin-id: 507f1f77bcf86cd799439011
{
  "name": "School Admin",
  "email": "admin@newschool.com",
  "password": "AdminPass123",
  "schoolName": "New School"
}
# Save: adminId = "507f1f77bcf86cd799439012"


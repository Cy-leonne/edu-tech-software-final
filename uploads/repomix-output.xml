    node scripts/mockMpesaCallback.js --checkout=ws_CO_1234567890 --result=0 --receipt=MPESA12345 --date=20240722123045
*/

const axios = require('axios');

const argv = (() => {
  const args = {};
  process.argv.slice(2).forEach(a => {
    const m = a.match(/^--?([^=]+)=?(.*)$/);
    if (m) args[m[1]] = m[2] || true;
  });

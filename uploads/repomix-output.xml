            ]
        }).select('-password');

        if (students.length === 0) {
            return res.status(404).send({ message: 'No students found for this parent' });
        }

        const studentData = students.map((s) => {
            const studentObj = s && typeof s.toObject === 'function' ? s.toObject({ getters: true }) : s;

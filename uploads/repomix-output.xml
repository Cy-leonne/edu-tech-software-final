POST /SuperAdmin/School/Create
x-admin-id: 507f1f77bcf86cd799439011
{
  "schoolName": "New School",
  "email": "admin@newschool.com",
  "phone": "0712345678",
  "schoolAdminId": "507f1f77bcf86cd799439012"

    log('\nMake sure:');
    log('1. Backend server is running on http://localhost:5000');
    log('2. MongoDB is connected');
    log('3. TEST_CONFIG.adminId and TEST_CONFIG.schoolId are correctly set', 'yellow');
    process.exit(1);
});
